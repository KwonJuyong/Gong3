{
  "name": "ai-eval-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:style": "node scripts/check-style.mjs",
    "verify": "tsc --noEmit && eslint && node scripts/check-style.mjs && npm run test:session && npm run test:query && npm run test:limits && npm run test:security",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "test:query": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-hooks.mjs scripts/query-selftest.mjs",
    "test:session": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-hooks.mjs scripts/session-selftest.mjs",
    "test:api": "node scripts/api-smoke.mjs",
    "test:security": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-hooks.mjs scripts/security-selftest.mjs",
    "test:limits": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-hooks.mjs scripts/limits-selftest.mjs",
    "bench:query": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-hooks.mjs scripts/query-benchmark.mjs",
    "check:metadata": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-hooks.mjs scripts/query-selftest.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@react-pdf/renderer": "^4.5.1",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "next": "16.4.2",
    "openai": "^4.77.0",
    "popbill": "^1.64.2",
    "prisma": "^6.2.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "^0.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
